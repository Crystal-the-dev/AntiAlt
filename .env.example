# Yapin' bot credentials
YAPPER_BOT_TOKEN=your_bot_token_here
# BOT_TOKEN is also accepted as an alternative to YAPPER_BOT_TOKEN.

# Yapin' OAuth app credentials
AUTH_TOKEN_WEBSITE_CLIENT_ID=your_oauth_client_id_here
AUTH_TOKEN_WEBSITE_CLIENT_SECRET=your_oauth_client_secret_here
AUTH_TOKEN_WEBSITE_CALLBACK=https://your-domain.example/callback
# These defaults are used when the variables below are omitted.
AUTH_TOKEN_WEBSITE_TOKEN_ENDPOINT=https://www.yapin.gg/api/oauth/token
AUTH_TOKEN_WEBSITE_IDENTITY_ENDPOINT=https://www.yapin.gg/api/oauth/me

# Local callback listener behind your reverse proxy
ANTIALT_HTTP_PORT=9283
ANTIALT_BIND_HOST=127.0.0.1
# Set true only when this callback is behind a reverse proxy you control.
# The proxy must overwrite the visitor IP header (for example CF-Connecting-IP).
ANTIALT_TRUST_PROXY=true
